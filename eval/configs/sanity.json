        "flags": {
          "--usage": "camera-realtime",
          "--complexity": "medium",
          "--cabac": "0",
          "--background-detection": "1",
          "--adaptive-quant": "0",
          "--scene-change": "0",
          "--denoise": "0",
          "--ltr": "0",
          "--frame-skip": "0",
          "--threads": "1",
          "--temporal-layers": "1"
