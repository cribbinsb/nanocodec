# AV1 OBU headers with obu_has_size_field (§5.3.2), with and without the
# extension byte, and the IVF FourCC.
td="\x12\x00"
seq="\x0a"
frame_header="\x1a"
tile_group="\x22"
metadata="\x2a"
frame="\x32"
redundant="\x3a"
tile_list="\x42"
padding="\x7a"
seq_ext="\x0e"
frame_ext="\x36"
td_ext="\x16"
ext_s1="\x08"
ext_t1="\x20"
fourcc="AV01"
# Shared framing entries (dict/common.dict).
sep="NCPK"
sc3="\x00\x00\x01"
sc4="\x00\x00\x00\x01"
ivf="DKIF"
