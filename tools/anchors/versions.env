# versions.env — pinned sources for every anchor encoder, reference decoder
# and metric tool used by the evaluation suite (eval/README.md "Methodology").
#
# Sourced by build_anchors.sh. Each tool has three entries:
#   <TOOL>_URL     git repository
#   <TOOL>_REF     release tag (or branch, for x264) that was pinned
#   <TOOL>_COMMIT  full commit hash the REF resolved to when pinned; the build
#                  fails if the fetched source does not match it
# To bump a tool: change REF, put the new `git ls-remote <url> <ref>^{}` hash
# in COMMIT, re-run build_anchors.sh (it rebuilds only what changed).
# Pinned 2026-11-06.

# --- Anchor encoders -------------------------------------------------------

OPENH264_URL=https://github.com/cisco/openh264.git
OPENH264_REF=v2.7.0
OPENH264_COMMIT=1bca62311e447fd9c39fc93de2c4b96cd5ce971c

# x264 has no release tags; the "stable" branch is the release channel.
X264_URL=https://code.videolan.org/videolan/x264.git
X264_REF=stable
X264_COMMIT=b35605ace3ddf7c1a5d67a2eb553f034aef41d55

X265_URL=https://bitbucket.org/multicoreware/x265_git.git
X265_REF=4.2
X265_COMMIT=e444744c03978c1fb4e037168967020cf2648427

KVAZAAR_URL=https://github.com/ultravideo/kvazaar.git
KVAZAAR_REF=v2.3.2
KVAZAAR_COMMIT=6040962bed5cc68c5ad01234c38c08b8b2822068

SVTAV1_URL=https://gitlab.com/AOMediaCodec/SVT-AV1.git
SVTAV1_REF=v4.3.0
SVTAV1_COMMIT=e3d63405f9ba8219913a7276c2c47d10e5d022fe

LIBAOM_URL=https://aomedia.googlesource.com/aom
LIBAOM_REF=v3.15.3
LIBAOM_COMMIT=b141d9c45db236335351c8a4b2a14b3ade27c937

# --- Decoders ----------------------------------------------------------------

DAV1D_URL=https://code.videolan.org/videolan/dav1d.git
DAV1D_REF=1.5.4
DAV1D_COMMIT=54706fc6bc0cdecab7e9593974a4039cc038fca7

# JM 19.0 as specified by the plan (JM-19.1 also exists).
JM_URL=https://vcgit.hhi.fraunhofer.de/jvet/JM.git
JM_REF=JM-19.0
JM_COMMIT=ef2362d159339d583fc18cea2de4d4bed5a1417c

# Decode-only FFmpeg for the conformance gates' libavcodec decoder (installed
# as bin/ffmpeg-decode, never as `ffmpeg`, so the metric preprocessing ffmpeg
# and the fingerprints that hash it are unchanged). >= 8.0 is required for VVC:
# 7.1.x reads uninitialised CC-ALF indexes when ALF is on (ticket 11325, fixed
# in f80af3657f) and mis-decodes our ALF streams. Its libdav1d is DAV1D above.
FFMPEG_URL=https://git.ffmpeg.org/ffmpeg.git
FFMPEG_REF=n8.0.1
FFMPEG_COMMIT=894da5ca7d742e4429ffb2af534fcda0103ef593

HM_URL=https://vcgit.hhi.fraunhofer.de/jvet/HM.git
HM_REF=HM-19.0
HM_COMMIT=24c021c6914b9a8e9cad2e00c28b76eb3ae8acc3

# --- Metrics -----------------------------------------------------------------

VMAF_URL=https://github.com/Netflix/vmaf.git
VMAF_REF=v3.2.1
VMAF_COMMIT=f85a853692a8c730d0270cd733c8bb30b5b93b7c

# --- Python-packaged tools (installed into <prefix>/venv) --------------------

MESON_PIP_VERSION=1.12.1
NINJA_PIP_VERSION=1.13.2
CLANG_FORMAT_PIP_VERSION=23.1.5

# --- VP9 / AV2 implementation branch (opt-in builds) --------------------------
# Resolved from annotated release tags on 2026-11-08.
LIBVPX_URL=https://github.com/webmproject/libvpx.git
LIBVPX_REF=v1.16.0
LIBVPX_COMMIT=1024874c5919305883187e2953de8fcb4c3d7fa6

AVM_URL=https://github.com/AOMediaCodec/avm.git
AVM_REF=v1.0.0
AVM_COMMIT=966a7d7cd6fcf60360caf5dc413b2aeeb65e144d

# Independent AV2 decoder. Exact inspected BSD-2-Clause revision; its basic
# sequence and gray-picture path matches the final AVM v1.0.0 syntax.
DAV2D_URL=https://code.videolan.org/videolan/dav2d.git
DAV2D_REF=237229e
DAV2D_COMMIT=237229ebfefd4eb8e0e25ad9636803bb93bae0c6

# --- VVC (nc-vvc, opt-in build) ------------------------------------------------
# VVdeC test decoder (BSD-3-Clause-Clear), the revision nc-vvc was validated
# against (docs/handoff/vvc.md). No release tag: REF is the short hash.
VVDEC_URL=https://github.com/fraunhoferhhi/vvdec.git
VVDEC_REF=d261469
VVDEC_COMMIT=d2614690cf13ceee1631dd6d30141755b8a689de
